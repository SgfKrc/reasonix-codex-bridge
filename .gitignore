# Per-machine bridge configuration (create it with `node src/configure.mjs use <ref>`)
bridge.config.json
*.doctor-cache.json
*.jsonl

# Per-machine preset tables (copy presets.example.json to create one)
presets.json

# Local env reference file. The bridge itself is zero-dependency and only reads
# process.env, so this file never has to be committed — and it holds machine
# paths and a machine-bound model ref.
.env
.env.*

node_modules/
